{
  "name": "quant-research-workbench-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "guard:external-runtime": "node scripts/assert_external_runtime.mjs",
    "preinstall": "npm run guard:external-runtime",
    "predev": "npm run guard:external-runtime",
    "dev": "vite",
    "prebuild": "npm run guard:external-runtime",
    "build": "tsc --noEmit && vite build",
    "prepreview": "npm run guard:external-runtime",
    "preview": "vite preview",
    "preui:review": "npm run guard:external-runtime",
    "ui:review": "node scripts/run_ui_review.mjs",
    "preui:review:full": "npm run guard:external-runtime",
    "ui:review:full": "node scripts/run_ui_review.mjs --mode full"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "katex": "^0.16.45",
    "lightweight-charts": "5.2.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.2",
    "vite": "7.3.3"
  }
}
