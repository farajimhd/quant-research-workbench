{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quant-research-workbench:news-synthesis:v1",
  "title": "News Synthesis V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "sample_id", "source_id", "source_timestamp",
    "source_text_sha256", "envelope", "entities", "statements",
    "participations", "issuer_views", "eligibility", "quality_flags",
    "migration"
  ],
  "properties": {
    "contract_version": {"const": "news_synthesis_v1"},
    "sample_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_timestamp": {"type": "string", "minLength": 1},
    "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope": {"$ref": "#/$defs/envelope"},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "statements": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "participations": {"type": "array", "items": {"$ref": "#/$defs/participation"}},
    "issuer_views": {"type": "array", "items": {"$ref": "#/$defs/issuerView"}},
    "eligibility": {"type": "array", "items": {"$ref": "#/$defs/eligibility"}},
    "quality_flags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "migration": {"$ref": "#/$defs/migration"}
  },
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_field", "start", "end", "quote"],
      "properties": {
        "source_field": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "rule_id", "evidence"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["document_structure", "communication_purpose", "information_origin", "production_method", "text_availability"],
      "properties": {
        "document_structure": {"$ref": "#/$defs/decision"},
        "communication_purpose": {"$ref": "#/$defs/decision"},
        "information_origin": {"$ref": "#/$defs/decision"},
        "production_method": {"$ref": "#/$defs/decision"},
        "text_availability": {"$ref": "#/$defs/decision"}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "entity_kind", "display_name", "ticker", "identity_status", "identity_evidence"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "entity_kind": {"enum": ["issuer", "security", "index", "fund", "commodity", "currency", "person", "organization", "place", "product"]},
        "display_name": {"type": "string"},
        "ticker": {"type": "string"},
        "identity_status": {"enum": ["resolved", "ambiguous", "unresolved", "not_tradable_as_of"]},
        "identity_evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_id", "statement_kind", "concept_leaf", "epistemic_status", "time_relation", "evidence_spans", "typed_facts"],
      "properties": {
        "statement_id": {"type": "string", "minLength": 1},
        "statement_kind": {"enum": ["event", "assessment", "forecast", "market_observation", "background", "reference"]},
        "concept_leaf": {"type": "string", "minLength": 1},
        "epistemic_status": {"enum": ["confirmed", "planned", "expected", "rumored", "conditional"]},
        "time_relation": {"enum": ["historical", "current", "forward"]},
        "evidence_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "typed_facts": {"type": "array", "items": {"type": "object"}}
      }
    },
    "participation": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_id", "entity_id", "semantic_role", "discourse_role", "semantic_sentiment", "sentiment_strength"],
      "properties": {
        "statement_id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "semantic_role": {"enum": ["affected_subject", "acquirer", "target", "counterparty", "none"]},
        "discourse_role": {"enum": ["claim_source", "context_mention", "none"]},
        "semantic_sentiment": {"enum": ["positive", "negative", "neutral"]},
        "sentiment_strength": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "issuerView": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "composite_sentiment", "positive_strength", "negative_strength", "statement_ids"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "composite_sentiment": {"enum": ["positive", "negative", "neutral", "mixed"]},
        "positive_strength": {"type": "integer", "minimum": 0, "maximum": 4},
        "negative_strength": {"type": "integer", "minimum": 0, "maximum": 4},
        "statement_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "eligibility": {
      "type": "object", "additionalProperties": false,
      "required": ["entity_id", "product", "eligible", "policy_id", "reasons", "blocking_flags"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "product": {"enum": ["forecast_trigger", "reaction_study", "issuer_history", "analyst_evaluation"]},
        "eligible": {"type": "boolean"},
        "policy_id": {"type": "string", "minLength": 1},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "blocking_flags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "migration": {
      "type": "object", "additionalProperties": false,
      "required": ["source_contract", "status", "issues"],
      "properties": {
        "source_contract": {"const": "news_semantic_ground_truth_annotation_v3"},
        "status": {"enum": ["exact", "rule_mapped", "review_required", "rejected"]},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
