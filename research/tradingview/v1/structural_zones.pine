//@version=6
indicator("Research: reaction zones v1 (v7 approximation)", overlay = true, max_boxes_count = 100)

days = input.int(30, "History / inactivity expiry (calendar days)", minval = 1, maxval = 365)
leftBars = input.int(10, "Pivot left bars", minval = 1, maxval = 500)
rightBars = input.int(10, "Pivot confirmation bars", minval = 1, maxval = 500)
mergePct = input.float(0.3, "Merge distance (%)", minval = 0.01, step = 0.05)
widthPct = input.float(0.1, "Minimum zone half-width (%)", minval = 0.01, step = 0.01)
minReactions = input.int(2, "Minimum confirmed reactions", minval = 1)
capacity = input.int(80, "Candidate capacity (error if exhausted)", minval = 10, maxval = 100)
displayCount = input.int(20, "Nearest qualified zones to display", minval = 1, maxval = 100)
maxDistance = input.float(25, "Maximum display distance (%)", minval = 0.1)
var centers = array.new<float>()
var lows = array.new<float>()
var highs = array.new<float>()
var counts = array.new<int>()
var touched = array.new<int>()
var drawings = array.new<box>()
var int firstLoaded = time
var int firstUsed = na
var int processed = 0
var status = table.new(position.top_right, 1, 3)
windowMs = days * 86400000
// Anchor initial loading to the latest chart bar, including closed markets.
cutoff = last_bar_time - windowMs
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

addReaction(float price, int stamp) =>
    int best = -1
    float distance = 1e20
    if array.size(centers) > 0
        for i = 0 to array.size(centers) - 1
            float d = math.abs(price - array.get(centers, i)) / array.get(centers, i) * 100
            if d <= mergePct and d < distance
                best := i
                distance := d
    if best < 0
        if array.size(centers) >= capacity
            runtime.error("Zone capacity exhausted. Increase capacity, merge distance, or reduce history.")
        array.push(centers, price)
        array.push(lows, price)
        array.push(highs, price)
        array.push(counts, 1)
        array.push(touched, stamp)
    else
        int n = array.get(counts, best)
        array.set(centers, best, array.get(centers, best) + (price - array.get(centers, best)) / (n + 1))
        array.set(lows, best, math.min(array.get(lows, best), price))
        array.set(highs, best, math.max(array.get(highs, best), price))
        array.set(counts, best, n + 1)
        array.set(touched, best, stamp)

if barstate.isconfirmed and time >= cutoff
    firstUsed := na(firstUsed) ? time : firstUsed
    processed += 1
    int i = array.size(centers) - 1
    while i >= 0
        if array.get(touched, i) < time - windowMs
            array.remove(centers, i)
            array.remove(lows, i)
            array.remove(highs, i)
            array.remove(counts, i)
            array.remove(touched, i)
        i -= 1
    // Attribute availability to this confirmation, not the earlier pivot.
    if not na(ph) and time[rightBars] >= cutoff
        addReaction(ph, time)
    if not na(pl) and time[rightBars] >= cutoff
        addReaction(pl, time)

if barstate.islast
    while array.size(drawings) > 0
        box.delete(array.pop(drawings))
    distances = array.new<float>()
    if array.size(centers) > 0
        for i = 0 to array.size(centers) - 1
            float d = math.abs(array.get(centers, i) - close) / close * 100
            bool eligible = array.get(counts, i) >= minReactions and array.get(touched, i) >= time - windowMs and d <= maxDistance
            array.push(distances, eligible ? d : 1e20)
        ranked = array.sort_indices(distances, order.ascending)
        int shown = 0
        for k = 0 to array.size(ranked) - 1
            int i = array.get(ranked, k)
            if shown < displayCount and array.get(distances, i) < 1e20
                float c = array.get(centers, i)
                float lo = math.min(array.get(lows, i), c * (1 - widthPct / 100))
                float hi = math.max(array.get(highs, i), c * (1 + widthPct / 100))
                color ink = close > hi ? color.green : close < lo ? color.red : color.orange
                string label = str.tostring(c, format.mintick) + " | reactions " + str.tostring(array.get(counts, i))
                array.push(drawings, box.new(left = time, top = hi, right = time + 60000, bottom = lo, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(ink, 35), bgcolor = color.new(ink, 90), text = label, text_color = ink, text_size = size.small))
                shown += 1
    float span = na(firstUsed) ? 0 : (time - firstUsed) / 86400000.0
    table.cell(status, 0, 0, "Approximate zones | chart " + timeframe.period)
    table.cell(status, 0, 1, "Used span " + str.tostring(span, "#.##") + " / " + str.tostring(days) + " days | bars " + str.tostring(processed))
    table.cell(status, 0, 2, firstLoaded > cutoff ? "Loaded history shorter than requested" : "Loaded history reaches requested cutoff", text_color = firstLoaded > cutoff ? color.orange : color.green)
