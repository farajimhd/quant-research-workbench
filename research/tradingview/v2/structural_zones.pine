//@version=6
indicator("Research: structural reaction levels v2", overlay = true, max_lines_count = 180, max_labels_count = 60, max_boxes_count = 60, max_bars_back = 1200)

days = input.int(30, "Rolling history (calendar days)", minval = 1, maxval = 365)
leftBars = input.int(10, "Pivot left bars", minval = 1, maxval = 500)
rightBars = input.int(10, "Pivot confirmation bars", minval = 1, maxval = 500)
minimumBucket = input.float(0.01, "Minimum reaction bucket spacing (price units)", minval = 0.0001, step = 0.01)
minimumDrawTicks = input.int(2, "Minimum displayed level separation (ticks)", minval = 1)
limitDistance = input.bool(false, "Restrict levels to maximum distance from latest price")
bucketPct = input.float(0.1, "Fixed price bucket width (%)", minval = 0.01, maxval = 5, step = 0.01)
atrLength = input.int(14, "Reaction ATR length", minval = 2, maxval = 500)
minimumATR = input.float(0.5, "Minimum confirmed move away (ATR)", minval = 0, step = 0.1)
separation = input.int(300, "Independent same-side reactions: separation seconds", minval = 0)
minimumCount = input.int(3, "Minimum independent reactions", minval = 1)
minimumDays = input.int(2, "Historical: minimum distinct reaction days", minval = 1)
halfLife = input.float(10, "Evidence recency half-life (days)", minval = 0.1)
perSide = input.int(8, "Zones above / below price", minval = 1, maxval = 30)
currentSlots = input.int(3, "Reserve current-day zones per side", minval = 0, maxval = 30)
showProvisional = input.bool(true, "Show provisional candidates (P, reduced opacity)")
maxDistance = input.float(3, "Maximum distance from price (%)", minval = 0.1)
showBands = input.bool(true, "Show estimated bands when available")
showBoundaryLines = input.bool(false, "Outline available lower / upper boundaries")
showText = input.bool(true, "Show text below main level")
labelOffset = input.int(0, "Axis text offset from rightmost visible candle (bars)", minval = -200, maxval = 200)
lineOpacity = input.int(65, "Line opacity (%)", minval = 0, maxval = 100)
textOpacity = input.int(90, "Text opacity (%)", minval = 0, maxval = 100)
bandTransparency = input.int(95, "Band transparency", minval = 80, maxval = 100)
sampleLimit = input.int(10000, "Maximum retained pivots (error if exhausted)", minval = 100, maxval = 20000)

type Reaction
    float price
    int pivotTime
    int availableTime
    int day
    int side
    float strength

type Zone
    array<float> prices
    int supports = 0
    int resistances = 0
    int lastSupport = na
    int lastResistance = na
    int lastDay = na
    int distinctDays = 0
    float score = 0
    bool currentDay = false

var samples = array.new<Reaction>()
var drawnLines = array.new<line>()
var drawnLabels = array.new<label>()
var drawnBands = array.new<box>()
var float referencePrice = na
var int referenceTime = na
var int referenceDay = na
int windowMs = days * 86400000
int loadCutoff = last_bar_time - windowMs
float stepLog = math.log(1 + bucketPct / 100)
float bucketScale = math.max(minimumBucket, syminfo.mintick * 2) / (bucketPct / 100)
float ph = ta.pivothigh(high, leftBars, rightBars)
float pl = ta.pivotlow(low, leftBars, rightBars)
float atr = ta.atr(atrLength)
int exchangeDay = time("1D")

record(float price, int side) =>
    float movement = side == 1 ? close - price : price - close
    float strength = atr[rightBars] > 0 ? movement / atr[rightBars] : na
    bool accepted = price > 0 and time[rightBars] >= loadCutoff and not na(strength) and strength >= minimumATR
    if accepted
        if array.size(samples) >= sampleLimit
            runtime.error("Retained pivot limit reached. Shorten history, increase pivot lengths / reaction threshold, or raise the explicit limit.")
        array.push(samples, Reaction.new(price, time[rightBars], time_close, exchangeDay[rightBars], side, strength))
    accepted

if barstate.isfirst and (not timeframe.isintraday or na(timeframe.in_seconds()))
    runtime.error("Use a standard time-based intraday candle chart.")

if barstate.isconfirmed and time >= loadCutoff
    referencePrice := close
    referenceTime := time_close
    referenceDay := exchangeDay
    // Expire by the reaction's actual time, not by most recent cluster contact.
    while array.size(samples) > 0
        Reaction oldest = array.get(samples, 0)
        if oldest.pivotTime < time - windowMs
            array.shift(samples)
        else
            break
    if not na(ph)
        bool accepted = record(ph, -1)
    if not na(pl)
        bool accepted = record(pl, 1)

// Rebuild only at the historical/live boundary and on completed live bars.
// Selection depends only on source reactions and inputs, never the visible viewport.
// The drawing is an as-of-now snapshot, even when extended over past candles.
if barstate.islastconfirmedhistory or (barstate.islast and barstate.isconfirmed)
    while array.size(drawnLines) > 0
        line.delete(array.pop(drawnLines))
    while array.size(drawnLabels) > 0
        label.delete(array.pop(drawnLabels))
    while array.size(drawnBands) > 0
        box.delete(array.pop(drawnBands))
    zones = array.new<Zone>()
    lookup = map.new<int, int>()
    float bookHigh = na
    float bookLow = na
    if array.size(samples) > 0
        for j = 0 to array.size(samples) - 1
            Reaction r = array.get(samples, j)
            bookHigh := na(bookHigh) ? r.price : math.max(bookHigh, r.price)
            bookLow := na(bookLow) ? r.price : math.min(bookLow, r.price)
            bool currentDay = r.day == referenceDay
            // Keep today's reactions separate from the prior-days seed.
            int key = int(math.floor(math.log(1 + r.price / bucketScale) / stepLog)) * 2 + (currentDay ? 1 : 0)
            if not map.contains(lookup, key)
                map.put(lookup, key, array.size(zones))
                array.push(zones, Zone.new(prices = array.new<float>(), currentDay = currentDay))
            Zone z = array.get(zones, map.get(lookup, key))
            int previous = r.side == 1 ? z.lastSupport : z.lastResistance
            if na(previous) or r.pivotTime - previous >= separation * 1000
                array.push(z.prices, r.price)
                if r.side == 1
                    z.supports += 1
                    z.lastSupport := r.pivotTime
                else
                    z.resistances += 1
                    z.lastResistance := r.pivotTime
                if na(z.lastDay) or r.day != z.lastDay
                    z.distinctDays += 1
                    z.lastDay := r.day
                float ageDays = math.max(0, (referenceTime - r.availableTime) / 86400000.0)
                z.score += math.min(r.strength, 5) * math.pow(0.5, ageDays / halfLife)
    distances = array.new<float>()
    priorities = array.new<float>()
    int currentTop = -1
    int currentBottom = -1
    float currentTopPrice = na
    float currentBottomPrice = na
    if array.size(zones) > 0
        for j = 0 to array.size(zones) - 1
            Zone z = array.get(zones, j)
            array.sort(z.prices)
            float center = array.size(z.prices) > 0 ? array.median(z.prices) : na
            float distance = math.abs(center / referencePrice - 1) * 100
            bool enoughCount = array.size(z.prices) >= minimumCount
            bool enoughDays = z.currentDay or z.distinctDays >= minimumDays
            bool nearby = not limitDistance or distance <= maxDistance
            bool qualified = enoughCount and enoughDays and nearby
            // Qualified levels first; then nearby provisional candidates fill vacancies.
            bool eligible = qualified or (showProvisional and nearby)
            array.push(distances, qualified ? distance : eligible ? 1000000 + distance : 1e20)
            // Today: strongest accepted reactions first, including explicitly provisional ones.
            // Historical selection retains qualified-first evidence ranking and region coverage.
            array.push(priorities, eligible ? z.currentDay ? 100 / (1 + z.score) : qualified ? 100 / (1 + z.score) : 1000000 + 100 / (1 + z.score) : 1e20)
            if eligible and z.currentDay
                if na(currentTopPrice) or center > currentTopPrice
                    currentTop := j
                    currentTopPrice := center
                if na(currentBottomPrice) or center < currentBottomPrice
                    currentBottom := j
                    currentBottomPrice := center
        ranked = array.sort_indices(priorities, order.ascending)
        int above = 0
        int below = 0
        drawnCenters = array.new<float>()
        captionPrices = array.new<float>()
        float drawingGap = math.max(minimumBucket, syminfo.mintick * minimumDrawTicks)
        float captionGap = drawingGap * 2
        selected = array.new<bool>(array.size(zones), false)
        historicalRegions = map.new<int, bool>()
        int regionsPerSide = math.max(1, perSide - math.min(currentSlots, perSide))
        for phase = 0 to 3
            for k = 0 to array.size(ranked) - 1
                int j = array.get(ranked, k)
                Zone z = array.get(zones, j)
                bool reservedPass = phase == 1
                bool extremePass = phase == 0
                bool historicalPass = phase == 2
                float candidateCenter = array.median(z.prices)
                bool candidateAbove = candidateCenter >= referencePrice
                float regionSpan = candidateAbove ? math.max(nz(bookHigh, referencePrice) - referencePrice, syminfo.mintick) : math.max(referencePrice - nz(bookLow, referencePrice), syminfo.mintick)
                int region = math.min(regionsPerSide - 1, int(math.floor(math.abs(candidateCenter - referencePrice) / regionSpan * regionsPerSide)))
                int regionKey = region * 2 + (candidateAbove ? 1 : 0)
                bool historicalEligible = not z.currentDay and not map.contains(historicalRegions, regionKey)
                bool alreadyDrawn = array.get(selected, j)
                bool reservedEligible = z.currentDay and ((array.median(z.prices) >= referencePrice and above < math.min(currentSlots, perSide)) or (array.median(z.prices) < referencePrice and below < math.min(currentSlots, perSide)))
                if not alreadyDrawn and (not extremePass or (currentSlots > 0 and (j == currentTop or j == currentBottom))) and (not reservedPass or reservedEligible) and (not historicalPass or historicalEligible) and array.get(distances, j) < 1e20
                    float center = array.median(z.prices)
                    bool overhead = center >= referencePrice
                    bool distinctDrawing = true
                    if array.size(drawnCenters) > 0
                        for existing = 0 to array.size(drawnCenters) - 1
                            if math.abs(center - array.get(drawnCenters, existing)) < drawingGap
                                distinctDrawing := false
                    if distinctDrawing and ((overhead and above < perSide) or (not overhead and below < perSide))
                        if historicalPass
                            map.put(historicalRegions, regionKey, true)
                        array.push(drawnCenters, center)
                        array.set(selected, j, true)
                        bool provisional = array.get(distances, j) >= 1000000
                        int uniquePrices = 1
                        if array.size(z.prices) > 1
                            for observation = 1 to array.size(z.prices) - 1
                                if array.get(z.prices, observation) - array.get(z.prices, observation - 1) >= syminfo.mintick * 0.5
                                    uniquePrices += 1
                        // No padding or bucket edges are substituted for missing geometry.
                        bool hasEstimate = not provisional and array.size(z.prices) >= 3 and uniquePrices >= 3
                        float lo = hasEstimate ? array.percentile_linear_interpolation(z.prices, 10) : na
                        float hi = hasEstimate ? array.percentile_linear_interpolation(z.prices, 90) : na
                        bool hasLower = not na(lo) and lo < center
                        bool hasUpper = not na(hi) and hi > center
                        bool hasBand = hasLower and hasUpper
                        color baseInk = referencePrice > (hasUpper ? hi : center) ? color.green : referencePrice < (hasLower ? lo : center) ? color.red : color.orange
                        color ink = color.new(baseInk, 100 - int(math.round(lineOpacity * (provisional ? 0.65 : 1.0))))
                        color textInk = color.new(baseInk, 100 - textOpacity)
                        int start = z.currentDay ? math.max(math.min(chart.left_visible_bar_time, time), referenceDay) : math.min(chart.left_visible_bar_time, time)
                        int finish = math.max(time + 1000, chart.right_visible_bar_time)
                        array.push(drawnLines, line.new(start, center, finish, center, xloc = xloc.bar_time, extend = extend.right, color = ink, width = 1, style = line.style_solid))
                        if showBoundaryLines and hasLower
                            array.push(drawnLines, line.new(start, lo, finish, lo, xloc = xloc.bar_time, extend = extend.right, color = ink, width = 1, style = line.style_solid))
                        if showBoundaryLines and hasUpper
                            array.push(drawnLines, line.new(start, hi, finish, hi, xloc = xloc.bar_time, extend = extend.right, color = ink, width = 1, style = line.style_solid))
                        if showBands and hasBand
                            array.push(drawnBands, box.new(start, hi, finish, lo, xloc = xloc.bar_time, extend = extend.right, border_color = color.new(ink, 100), bgcolor = color.new(ink, bandTransparency)))
                        bool captionFits = true
                        if array.size(captionPrices) > 0
                            for existing = 0 to array.size(captionPrices) - 1
                                if math.abs(center - array.get(captionPrices, existing)) < captionGap
                                    captionFits := false
                        if showText and captionFits
                            array.push(captionPrices, center)
                            int textTime = chart.right_visible_bar_time + int(labelOffset * timeframe.in_seconds() * 1000)
                            float textPrice = center - math.max(syminfo.mintick * 2, nz(atr) * 0.08)
                            string caption = (z.currentDay ? "DAY " : "HIST ") + (provisional ? "P " : "") + (center > referencePrice ? "R " : "S ") + str.tostring(center, format.mintick) + (hasLower ? " L:" + str.tostring(lo, format.mintick) : "") + (hasUpper ? " U:" + str.tostring(hi, format.mintick) : "")
                            array.push(drawnLabels, label.new(textTime, textPrice, caption, xloc = xloc.bar_time, style = label.style_label_upper_right, color = color.new(color.white, 100), textcolor = textInk, size = size.small, textalign = text.align_right))
                        if overhead
                            above += 1
                        else
                            below += 1

// Keep right-aligned text beside the rightmost visible candle, including when panned.
// Pine has no pixel anchor to the price axis; the bars offset is user-adjustable.
if barstate.islast and array.size(drawnLabels) > 0
    int textTime = chart.right_visible_bar_time + int(labelOffset * timeframe.in_seconds() * 1000)
    for j = 0 to array.size(drawnLabels) - 1
        label.set_x(array.get(drawnLabels, j), textTime)
