<clickhouse>
    <!--
      One-node coordination authority for this one-node workstation deployment.
      Its Raft log and snapshots live on the verified live-market SSD, never
      the ClickHouse default/backup disk. The Windows host must not forward
      unauthenticated port 9181 to the LAN. Remote clients require a separately
      approved secure transport and ACL before trading cutover.
    -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <four_letter_word_white_list>ruok</four_letter_word_white_list>
        <server_id>1</server_id>
        <log_storage_path>/clickhouse-disks/live-market/keeper/log</log_storage_path>
        <snapshot_storage_path>/clickhouse-disks/live-market/keeper/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <min_session_timeout_ms>10000</min_session_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>information</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>127.0.0.1</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
    <zookeeper>
        <node>
            <host>127.0.0.1</host>
            <port>9181</port>
        </node>
    </zookeeper>
</clickhouse>
