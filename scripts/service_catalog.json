{
  "schema_version": 1,
  "profiles": {
    "app": ["backend", "frontend"],
    "historical-core": ["qmd-history", "backend", "frontend"],
    "historical": ["qmd-history", "bar-gpt", "backend", "frontend"],
    "live-core": ["qmd-live", "qmd-history", "news-gateway", "sec-gateway", "ibkr-supervisor", "reference-gateway", "model-gateway", "news-hypothesis", "text-intelligence", "backend", "frontend"],
    "live": ["qmd-live", "qmd-history", "news-gateway", "sec-gateway", "ibkr-supervisor", "reference-gateway", "model-gateway", "news-hypothesis", "text-intelligence", "bar-gpt", "backend", "frontend"],
    "gateways": ["qmd-live", "news-gateway", "sec-gateway", "ibkr-supervisor", "reference-gateway"],
    "market-data": ["qmd-live", "qmd-history"],
    "intelligence": ["model-gateway", "news-hypothesis", "text-intelligence", "bar-gpt"],
    "middleware": ["model-gateway", "news-hypothesis", "text-intelligence", "bar-gpt"],
    "documents": ["news-gateway", "sec-gateway", "text-intelligence"],
    "all": ["qmd-live", "qmd-history", "news-gateway", "sec-gateway", "ibkr-supervisor", "reference-gateway", "model-gateway", "news-hypothesis", "text-intelligence", "bar-gpt", "backend", "frontend"]
  },
  "services": {
    "qmd-live": {
      "title": "QMD Live",
      "role": "qmd_live",
      "port": 8795,
      "health_url": "http://127.0.0.1:8795/health",
      "launch_kind": "qmd_live",
      "readiness": {"kind": "qmd_live", "accepted_statuses": ["running", "closed", "catching_up"], "require_running": true, "snapshot_url": "http://127.0.0.1:8795/snapshot/status", "max_event_lag_seconds": 30, "queue_saturation_ratio": 0.95},
      "start_priority": 5,
      "fingerprint_env": ["QMD_DERIVED_RECONCILIATION_ENABLED", "QMD_DERIVED_RECONCILIATION_INTERVAL_MS"],
      "dependencies": [],
      "graceful_timeout_seconds": 20,
      "watch": ["services/qmd-gateway/**", "scripts/run_qmd_gateway.ps1", "scripts/start_qmd_live_gateway.ps1", "scripts/stop_qmd_live_gateway.ps1"]
    },
    "qmd-history": {
      "title": "QMD History",
      "role": "qmd_history",
      "port": 8801,
      "health_url": "http://127.0.0.1:8801/health",
      "launcher": "scripts/run_qmd_history_gateway.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["ready"], "require_running": true},
      "environment": {"QMD_HISTORY_BIND": "127.0.0.1:8801"},
      "start_priority": 10,
      "fingerprint_env": ["QMD_HISTORY_BIND", "QMD_HISTORY_CARGO_TARGET_DIR"],
      "dependencies": [],
      "graceful_timeout_seconds": 20,
      "watch": ["services/qmd_history_gateway/**", "services/qmd-gateway/**", "scripts/run_qmd_history_gateway.ps1"]
    },
    "backend": {
      "title": "Backend",
      "role": "backend",
      "port": 8000,
      "health_url": "http://127.0.0.1:8000/api/health",
      "launcher": "scripts/run_backend.ps1",
      "readiness": {"kind": "transport"},
      "arguments": ["-HostName", "127.0.0.1", "-Port", "8000", "-PythonExe", "{python}", "-NoReload"],
      "start_priority": 80,
      "fingerprint_env": ["TEXT_INTELLIGENCE_URL", "TEXT_INTELLIGENCE_SEC_REVIEW_ADMISSION_TIMEOUT_SECONDS"],
      "dependencies": ["qmd-history"],
      "graceful_timeout_seconds": 15,
      "watch": ["src/backend/**", "src/runtime_paths.py", "scripts/run_backend.py", "scripts/run_backend.ps1"]
    },
    "frontend": {
      "title": "Frontend",
      "role": "frontend",
      "port": 5173,
      "health_url": "http://127.0.0.1:5173/",
      "launch_kind": "python",
      "launcher": "scripts/run_frontend.py",
      "readiness": {"kind": "transport"},
      "arguments": ["dev", "--", "--host", "127.0.0.1", "--port", "5173"],
      "start_priority": 90,
      "fingerprint_env": ["VITE_API_PROXY_TARGET", "VITE_API_WS_TARGET"],
      "dependencies": ["backend"],
      "graceful_timeout_seconds": 10,
      "watch": ["frontend/src/**", "frontend/index.html", "frontend/package.json", "frontend/package-lock.json", "frontend/tsconfig.json", "frontend/vite.config.ts", "scripts/run_frontend.py"]
    },
    "news-gateway": {
      "title": "News Gateway",
      "role": "news_gateway",
      "port": 8796,
      "health_url": "http://127.0.0.1:8796/health",
      "launcher": "scripts/run_news_gateway.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["running", "idle"]},
      "arguments": ["-CondaEnv", "ml4t", "-PythonExe", "{python}"],
      "environment": {
        "NEWS_TERMINAL_RICH_ENABLED": "true",
        "NEWS_TERMINAL_SCREEN_ENABLED": "true",
        "NEWS_BENZINGA_BODY_V4_SHADOW_ENABLED": "true",
        "NEWS_BENZINGA_BODY_V4_SHADOW_END_UTC": "2026-10-31T00:00:00Z"
      },
      "start_priority": 20,
      "fingerprint_env": ["NEWS_GATEWAY_BIND", "NEWS_BENZINGA_BODY_V4_SHADOW_ENABLED", "NEWS_BENZINGA_BODY_V4_SHADOW_END_UTC"],
      "dependencies": [],
      "graceful_timeout_seconds": 330,
      "watch": ["services/news_gateway/**", "services/gateway_core/**", "pipelines/news/benzinga/**", "scripts/run_news_gateway.ps1"]
    },
    "sec-gateway": {
      "title": "SEC Gateway",
      "role": "sec_gateway",
      "port": 8797,
      "health_url": "http://127.0.0.1:8797/health",
      "launcher": "scripts/run_sec_gateway.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["running", "idle", "catching_up"]},
      "arguments": ["-CondaEnv", "ml4t", "-PythonExe", "{python}"],
      "environment": {"SEC_GATEWAY_TERMINAL_RICH_ENABLED": "true", "SEC_GATEWAY_TERMINAL_SCREEN_ENABLED": "true"},
      "start_priority": 20,
      "fingerprint_env": ["SEC_GATEWAY_BIND"],
      "dependencies": [],
      "graceful_timeout_seconds": 330,
      "watch": ["services/sec_gateway/**", "services/gateway_core/**", "scripts/run_sec_gateway.ps1"]
    },
    "ibkr-supervisor": {
      "title": "IBKR Supervisor",
      "role": "ibkr_gateway_supervisor",
      "port": 8800,
      "health_url": "http://127.0.0.1:8800/health",
      "launcher": "scripts/run_ibkr_gateway_supervisor.ps1",
      "readiness": {"kind": "ibkr", "accepted_statuses": ["running"]},
      "arguments": ["-PythonExe", "{python}", "-Account", "{ibkr_account}"],
      "environment": {"IBKR_GATEWAY_TERMINAL_RICH_ENABLED": "true", "IBKR_GATEWAY_TERMINAL_SCREEN_ENABLED": "true"},
      "start_priority": 20,
      "fingerprint_env": ["IBKR_GATEWAY_SUPERVISOR_BIND"],
      "dependencies": [],
      "graceful_timeout_seconds": 45,
      "watch": ["services/ibkr_gateway_supervisor/**", "services/gateway_core/**", "scripts/run_ibkr_gateway_supervisor.ps1"]
    },
    "reference-gateway": {
      "title": "Reference Gateway",
      "role": "reference_gateway",
      "port": 8799,
      "health_url": "http://127.0.0.1:8799/health",
      "launcher": "scripts/run_reference_gateway.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["running", "idle"]},
      "arguments": ["-PythonExe", "{python}"],
      "environment": {"REFERENCE_GATEWAY_TERMINAL_RICH_ENABLED": "true", "REFERENCE_GATEWAY_TERMINAL_SCREEN_ENABLED": "true"},
      "start_priority": 30,
      "fingerprint_env": ["REFERENCE_GATEWAY_BIND"],
      "dependencies": ["ibkr-supervisor"],
      "graceful_timeout_seconds": 90,
      "watch": ["services/reference_gateway/**", "services/gateway_core/**", "scripts/run_reference_gateway.ps1", "scripts/repository_code_authority.ps1"]
    },
    "model-gateway": {
      "title": "Model Gateway",
      "role": "model_gateway",
      "port": 8802,
      "health_url": "http://127.0.0.1:8802/health",
      "launcher": "scripts/run_model_gateway.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["ready"]},
      "arguments": ["-PythonExe", "{python}"],
      "start_priority": 20,
      "fingerprint_env": ["MODEL_GATEWAY_BIND", "MODEL_GATEWAY_FAST_MODEL", "MODEL_GATEWAY_DEEP_MODEL", "MODEL_GATEWAY_NEWS_REVIEW_PROVIDERS", "MODEL_GATEWAY_NEWS_REVIEW_TIMEOUT_SECONDS", "MODEL_GATEWAY_SEC_REVIEW_PROVIDERS", "MODEL_GATEWAY_SEC_REVIEW_TIMEOUT_SECONDS"],
      "dependencies": [],
      "graceful_timeout_seconds": 20,
      "watch": ["services/model_gateway/**", "scripts/run_model_gateway.ps1"]
    },
    "news-hypothesis": {
      "title": "News Hypothesis",
      "role": "news_hypothesis",
      "port": 8803,
      "health_url": "http://127.0.0.1:8803/health",
      "launcher": "scripts/run_news_hypothesis.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["ready"]},
      "arguments": ["-PythonExe", "{python}"],
      "environment": {"NEWS_HYPOTHESIS_TRIGGER_MODE": "manual"},
      "start_priority": 30,
      "fingerprint_env": ["NEWS_HYPOTHESIS_BIND", "NEWS_HYPOTHESIS_TRIGGER_MODE"],
      "dependencies": ["model-gateway"],
      "graceful_timeout_seconds": 30,
      "watch": ["services/news-hypothesis/**", "scripts/run_news_hypothesis.ps1"]
    },
    "text-intelligence": {
      "title": "Text Intelligence",
      "role": "text_intelligence",
      "port": 8804,
      "health_url": "http://127.0.0.1:8804/health",
      "launcher": "scripts/run_text_intelligence.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["running", "idle"]},
      "arguments": ["-CondaEnv", "ml4t", "-PythonExe", "{python}"],
      "environment": {"TEXT_INTELLIGENCE_REVIEW_TRIGGER_MODE": "manual", "TEXT_INTELLIGENCE_TERMINAL_RICH_ENABLED": "true", "TEXT_INTELLIGENCE_TERMINAL_SCREEN_ENABLED": "true"},
      "start_priority": 40,
      "fingerprint_env": ["TEXT_INTELLIGENCE_BIND", "TEXT_INTELLIGENCE_FORECAST_MODEL_DEVICE", "TEXT_INTELLIGENCE_FORECAST_ELIGIBILITY_THRESHOLD", "TEXT_INTELLIGENCE_REVIEW_TRIGGER_MODE", "TEXT_INTELLIGENCE_SEC_RECONCILE_HOURS"],
      "artifact_paths": ["{text_intelligence_release_manifest}"],
      "dependencies": [],
      "graceful_timeout_seconds": 45,
      "watch": ["services/text-intelligence/**", "research/text_intelligence/**", "services/gateway_core/**", "scripts/run_text_intelligence.ps1"]
    },
    "bar-gpt": {
      "title": "BarGPT",
      "role": "bar_gpt",
      "port": 8805,
      "health_url": "http://127.0.0.1:8805/health",
      "launcher": "scripts/run_bar_gpt.ps1",
      "readiness": {"kind": "service", "accepted_statuses": ["ready", "warming"]},
      "arguments": ["-Bind", "127.0.0.1:8805", "-ReleaseManifest", "{bar_gpt_release_manifest}", "-PythonExe", "{python}"],
      "artifact_paths": ["{bar_gpt_release_manifest}"],
      "start_priority": 40,
      "fingerprint_env": ["BAR_GPT_DEVICE"],
      "dependencies": ["qmd-history"],
      "graceful_timeout_seconds": 45,
      "watch": ["services/bar-gpt/**", "research/bar_gpt/**", "scripts/run_bar_gpt.ps1"]
    }
  }
}
